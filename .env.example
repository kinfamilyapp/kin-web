# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Claude AI ────────────────────────────────────────────────
VITE_ANTHROPIC_API_KEY=sk-ant-your-key

# ── Stripe ───────────────────────────────────────────────────
# Set these in Supabase Edge Function secrets (not here):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...   (your $4.99/mo recurring price)
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ───────────────────────────────────────────
# Set in Supabase Edge Function secrets:
# RESEND_API_KEY=re_...

# ── Push Notifications (VAPID) ───────────────────────────────
# Generate once: node scripts/generate-vapid-keys.js
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
# Set VAPID_PRIVATE_KEY and VAPID_SUBJECT in Supabase Edge Function secrets only

# ── Google Calendar OAuth ─────────────────────────────────────
# Set up at: https://console.cloud.google.com
# APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: https://YOUR_PROJECT.supabase.co/functions/v1/google-oauth-callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Set in Supabase Edge Function secrets only (never in .env):
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# APP_URL=https://yourapp.com
